#!/usr/bin/env bash
# =============================================================================
# CalNexus post-commit hook — clean local build artifacts.
#
# Runs after each successful commit. Best-effort only: it must never fail
# (the commit already exists at this point), so every command is guarded.
#
# Removes:
#   - cargo target/ directories (all profiles: debug, release, ...)
#   - Python artifacts: __pycache__/, *.pyc/*.pyo, pytest/mypy/ruff caches,
#     .hypothesis/, *.egg-info/, and root build/ dist/ (only if untracked)
#
# Install (one-time, per clone):
#   git config core.hooksPath .githooks
# =============================================================================

set -u

# Run from the repository root; bail out silently if git is unavailable.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

cargo clean >/dev/null 2>&1

# Rust build dirs (covers nested standalone workspaces that `cargo clean`
# at the root does not reach). Skip node_modules/.venv while walking.
find . \( -name node_modules -o -name .venv \) -prune \
    -o -type d -name target -prune -exec rm -rf {} +

# Python caches and bytecode
find . \( -name node_modules -o -name .venv \) -prune \
    -o -type d \( -name __pycache__ -o -name .pytest_cache -o -name .mypy_cache \
       -o -name .ruff_cache -o -name .hypothesis -o -name '*.egg-info' \) \
    -prune -exec rm -rf {} +
find . \( -name node_modules -o -name .venv \) -prune \
    -o -type f \( -name '*.pyc' -o -name '*.pyo' \) -exec rm -f {} +

# Python packaging output at the repo root — only when nothing there is tracked
if [ -z "$(git ls-files build dist)" ]; then
    rm -rf build dist
fi

echo "[post-commit] cleaned: cargo target/ + Python build artifacts"
exit 0
