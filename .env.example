# CalNexus environment variables
#
# CalNexus is a command-line math expression evaluator; configuration is minimal.
# All variables are OPTIONAL and have sensible defaults — you do not need this
# file to run the tool. CLI flags take precedence over environment variables
# (priority: flag > env > default).
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env

# Evaluation timeout in seconds (same as --timeout; range 0.1-3600).
# Applies to single-expression, REPL, and batch modes.
# Default: 5
CALNEXUS_TIMEOUT=5

# Cache entry budget, approximate (entries x 4KB byte cap; same as --cache-size).
# Larger values trade memory for hit rate. Default: 10000 (= ~40MB byte cap).
CALNEXUS_CACHE_SIZE=10000

# HTTP server bind address, --serve-http mode only (same as --bind).
# Default: 127.0.0.1:3000 (loopback only; use a reverse proxy for exposure).
CALNEXUS_BIND_ADDR=127.0.0.1:3000

# Exchange-rate cache TTL in hours (fx domain, frankfurter.dev upstream).
# Default: 24
CALNEXUS_FX_TTL_HOURS=24

# Allow serving stale exchange-rate snapshots when the upstream is unreachable
# (fx domain; "1" enables the stale fallback).
# Default: unset (stale fallback disabled)
# CALNEXUS_FX_ALLOW_STALE=1

# Log filtering for the observability subsystem (server mode; `observability`
# feature installs a tracing-subscriber EnvFilter consuming this variable).
# Syntax: https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/EnvFilter/index.html
# Default (feature enabled, variable unset): warn
# RUST_LOG=debug
